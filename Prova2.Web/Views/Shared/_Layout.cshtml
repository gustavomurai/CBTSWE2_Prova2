@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Prova2</title>

    <style>
        :root {
            --azul: #172554;
            --azul-claro: #2563eb;
            --azul-hover: #1d4ed8;
            --fundo: #f3f5f9;
            --texto: #263247;
            --cinza: #64748b;
            --borda: #e2e8f0;
            --branco: #ffffff;
            --verde: #166534;
            --verde-fundo: #dcfce7;
            --vermelho: #991b1b;
            --vermelho-fundo: #fee2e2;
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: var(--fundo);
            font-family: Arial, Helvetica, sans-serif;
            color: var(--texto);
        }

        header {
            min-height: 74px;
            background: var(--azul);
            color: white;
            padding: 16px 5%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .08);
        }

            header h2 {
                margin: 0;
                font-size: 22px;
                font-weight: 700;
                letter-spacing: -.4px;
            }

        nav {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 22px;
            flex-wrap: wrap;
        }

            nav a {
                color: white;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
            }

                nav a:hover {
                    color: #bfdbfe;
                }

            nav span {
                font-size: 14px;
            }

            nav form {
                margin: 0;
            }

        .container {
            width: 90%;
            max-width: 1250px;
            margin: 35px auto;
            flex: 1;
        }

        .pagina,
        .formulario-container {
            background: var(--branco);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
        }

        .cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            gap: 15px;
        }

        h1 {
            margin-top: 0;
            color: var(--azul);
            font-size: 28px;
            letter-spacing: -.5px;
        }

        h2 {
            color: var(--azul);
        }

        p {
            line-height: 1.6;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-weight: 600;
                font-size: 14px;
            }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-size: 15px;
            color: var(--texto);
            background: white;
            transition: border-color .2s, box-shadow .2s;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--azul-claro);
                box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
            }

        .botao {
            display: inline-block;
            border: none;
            padding: 11px 18px;
            border-radius: 7px;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            text-align: center;
            transition: background .2s, transform .2s;
        }

            .botao:hover {
                opacity: .92;
                transform: translateY(-1px);
            }

        .botao-principal {
            background: var(--azul-claro);
            color: white;
        }

            .botao-principal:hover {
                background: var(--azul-hover);
            }

        .botao-editar {
            background: #e0edff;
            color: #1d4ed8;
        }

        .botao-excluir {
            background: #dc2626;
            color: white;
        }

        .botao-voltar {
            background: #64748b;
            color: white;
        }

        .tabela-container {
            width: 100%;
            overflow-x: auto;
        }

        .tabela {
            width: 100%;
            border-collapse: collapse;
        }

            .tabela th,
            .tabela td {
                padding: 14px 12px;
                border-bottom: 1px solid var(--borda);
                text-align: left;
                font-size: 14px;
            }

            .tabela th {
                background: #f1f5f9;
                color: #334155;
                font-weight: 700;
            }

            .tabela tbody tr:hover {
                background: #f8fafc;
            }

        .acoes {
            display: flex;
            gap: 8px;
            align-items: center;
        }

            .acoes form {
                margin: 0;
            }

        .status {
            display: inline-block;
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .ativo {
            background: var(--verde-fundo);
            color: var(--verde);
        }

        .inativo {
            background: var(--vermelho-fundo);
            color: var(--vermelho);
        }

        .login-container {
            min-height: 65vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: white;
            width: 100%;
            max-width: 430px;
            padding: 38px;
            border-radius: 14px;
            box-shadow: 0 5px 25px rgba(15, 23, 42, .08);
        }

            .login-card h1 {
                color: var(--azul-claro);
                text-align: center;
                margin-bottom: 8px;
            }

            .login-card h2,
            .login-card p {
                text-align: center;
            }

            .login-card button {
                width: 100%;
                margin-top: 10px;
            }

        .mensagem-erro {
            display: block;
            color: #dc2626;
            margin-top: 5px;
            font-size: 13px;
        }

        .alerta {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alerta-sucesso {
            background: var(--verde-fundo);
            color: var(--verde);
        }

        .alerta-erro {
            background: var(--vermelho-fundo);
            color: var(--vermelho);
        }

        .vazio {
            padding: 50px 20px;
            text-align: center;
            background: #f8fafc;
            border-radius: 8px;
            color: var(--cinza);
        }

        .botoes-formulario {
            display: flex;
            gap: 10px;
            margin-top: 25px;
            flex-wrap: wrap;
        }

        footer {
            width: 100%;
            text-align: center;
            padding: 25px 15px;
            color: var(--cinza);
            font-size: 13px;
            line-height: 1.8;
            margin-top: auto;
        }

            footer .autores {
                margin-top: 5px;
                color: #334155;
                font-weight: 600;
            }

        @@media (max-width: 700px) {
            header,
            .cabecalho {
                flex-direction: column;
                align-items: flex-start;
            }

            header {
                padding: 18px 5%;
            }

            nav {
                justify-content: flex-start;
                gap: 14px;
            }

            .container {
                width: 94%;
                margin: 22px auto;
            }

            .pagina,
            .formulario-container {
                padding: 20px;
            }

            .login-card {
                padding: 25px;
            }

            .acoes {
                flex-wrap: wrap;
            }
        }
    </style>
</head>

<body>

    <header>

        <h2>Prova2 - Sistema</h2>

        <nav>

            @if (!string.IsNullOrEmpty(
                        Context.Session.GetString("JwtToken")))
            {
                <a asp-controller="Produtos"
                   asp-action="Index">
                    Produtos
                </a>

                <span>
                    Olá, @Context.Session.GetString("UsuarioNome")
                </span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="botao botao-excluir">
                        Sair
                    </button>

                </form>
            }

        </nav>

    </header>

    <main class="container">

        @if (TempData["Sucesso"] != null)
        {
            <div class="alerta alerta-sucesso">
                @TempData["Sucesso"]
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="alerta alerta-erro">
                @TempData["Erro"]
            </div>
        }

        @RenderBody()

    </main>

    <footer>

        <div>
            Sistema de Gerenciamento - Prova2
        </div>

        <div class="autores">
            Desenvolvido por Gustavo Cerqueira Murai
            (CB3033261) e Igor Cerqueira Murai (CB3033295).
        </div>

    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

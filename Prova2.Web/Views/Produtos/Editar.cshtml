@model Prova2.Web.Models.ProdutoViewModel

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="formulario-container">

    <h1>Editar Produto</h1>

    <p>Atualize as informações do produto cadastrado.</p>

    <form asp-controller="Produtos"
          asp-action="Editar"
          asp-route-id="@Model.Id"
          method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="mensagem-erro"></div>

        <div class="form-group">

            <label>ID do produto</label>

            <input value="@Model.Id"
                   class="form-control"
                   readonly />

        </div>

        <div class="form-group">

            <label asp-for="Nome">Nome do produto</label>

            <input asp-for="Nome"
                   class="form-control" />

            <span asp-validation-for="Nome"
                  class="mensagem-erro"></span>

        </div>

        <div class="form-group">

            <label asp-for="Preco">Preço (R$)</label>

            <input asp-for="Preco"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control" />

            <span asp-validation-for="Preco"
                  class="mensagem-erro"></span>

        </div>

        <div class="form-group">

            <label asp-for="Status">Status do produto</label>

            <select asp-for="Status" class="form-control">

                <option value="true">Ativo</option>

                <option value="false">Inativo</option>

            </select>

        </div>

        <hr />

        <h3>Informações de auditoria</h3>

        <div class="form-group">

            <label>Usuário que cadastrou</label>

            <input value="@Model.IdUsuarioCadastro"
                   class="form-control"
                   readonly />

        </div>

        <div class="form-group">

            <label>Último usuário que alterou</label>

            <input value="@Model.IdUsuarioUpdate"
                   class="form-control"
                   readonly />

        </div>

        <div class="botoes-formulario">

            <button type="submit"
                    class="botao botao-principal">

                Salvar Alterações

            </button>

            <a asp-action="Index"
               class="botao botao-voltar">

                Voltar

            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

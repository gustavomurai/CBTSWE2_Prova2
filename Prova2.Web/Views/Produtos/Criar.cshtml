@model Prova2.Web.Models.ProdutoViewModel

@{
    ViewData["Title"] = "Cadastrar Produto";
}

<div class="formulario-container">

    <h1>Cadastrar Produto</h1>

    <p>Preencha os dados para cadastrar um novo produto.</p>

    <form asp-controller="Produtos"
          asp-action="Criar"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="mensagem-erro"></div>

        <div class="form-group">

            <label asp-for="Nome">Nome do produto</label>

            <input asp-for="Nome"
                   class="form-control"
                   placeholder="Digite o nome do produto" />

            <span asp-validation-for="Nome"
                  class="mensagem-erro"></span>

        </div>

        <div class="form-group">

            <label asp-for="Preco">Preço (R$)</label>

            <input asp-for="Preco"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   placeholder="0,00" />

            <span asp-validation-for="Preco"
                  class="mensagem-erro"></span>

        </div>

        <div class="form-group">

            <label asp-for="Status">Status do produto</label>

            <select asp-for="Status" class="form-control">

                <option value="true">Ativo</option>

                <option value="false">Inativo</option>

            </select>

        </div>

        <div class="alerta"
             style="background:#f1f5f9;color:#475569;">

            Os dados de cadastro e atualização serão
            registrados automaticamente pelo sistema.

        </div>

        <div class="botoes-formulario">

            <button type="submit"
                    class="botao botao-principal">

                Cadastrar Produto

            </button>

            <a asp-action="Index"
               class="botao botao-voltar">

                Voltar

            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
